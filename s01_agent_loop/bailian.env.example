# Copy these settings into the project root's .env.
# Beijing pay-as-you-go API key; replace the placeholder with your real key.
ANTHROPIC_API_KEY=your-bailian-api-key
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
MODEL_ID=qwen-plus

# Alternatively, use your workspace-specific Beijing endpoint:
# ANTHROPIC_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/apps/anthropic
# Other regions must use their matching API key and endpoint.
# Do not use /compatible-mode/v1 or append /v1/messages to this base URL.
# Docs: https://help.aliyun.com/zh/model-studio/anthropic-api-messages
